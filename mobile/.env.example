# CasaMotion mobile — environment
# Copy this file to `.env` and adjust for your machine.

# Base URL of the FastAPI backend (api/main.py). Include the host + port only.
# The app appends the "/api" path itself.
#   - Android emulator ->  http://10.0.2.2:8000
#   - iOS simulator    ->  http://localhost:8000
#   - Physical device  ->  http://<your-LAN-IP>:8000   (e.g. http://192.168.1.20:8000)
#   - Web (expo start --web) -> http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Maps API key — only needed for real maps on Android dev/production builds.
# Leave blank for Expo Go / web (the app shows a styled fallback map).
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
